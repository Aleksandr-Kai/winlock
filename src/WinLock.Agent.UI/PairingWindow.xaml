<Window x:Class="WinLock.Agent.UI.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Привязка WinLock" Width="440" MinWidth="380"
        SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#151B23">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="Привязка родительского приложения" Foreground="White" FontSize="20"
                       FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,14" />

            <Border Background="#1D2530" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ServiceStatusText" Grid.Column="0" Foreground="#9AA5B1" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap" Text="Проверяем службу WinLock..." />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="StartServiceButton" Content="Запустить" Padding="10,4" FontSize="11"
                                Margin="8,0,0,0" IsEnabled="False" Click="StartServiceButton_Click" />
                        <Button x:Name="StopServiceButton" Content="Остановить" Padding="10,4" FontSize="11"
                                Margin="8,0,0,0" IsEnabled="False" Click="StopServiceButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="#9AA5B1" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <Border Background="White" CornerRadius="8" Padding="12"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Image x:Name="QrImage" Width="260" Height="260" />
            </Border>

            <TextBlock Text="Откройте приложение WinLock на телефоне родителя и отсканируйте этот QR-код."
                       Foreground="#9AA5B1" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12" />

            <TextBlock Text="Или скопируйте текст ниже, если сканировать нечем:"
                       Foreground="#9AA5B1" FontSize="11" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBox x:Name="QrTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                     FontSize="11" Padding="6" MaxHeight="80" Margin="0,0,0,20" />

            <Button x:Name="CloseButton" Content="Закрыть" Padding="0,10" FontSize="14" Click="CloseButton_Click" />

            <TextBlock x:Name="VersionText" Foreground="#5A6270" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
