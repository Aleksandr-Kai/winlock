<Window x:Class="WinLock.Agent.UI.WarningToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLock"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" SizeToContent="WidthAndHeight">
    <Border Background="#DD151B23" CornerRadius="10" Padding="18,14"
            BorderBrush="#2A3441" BorderThickness="1">
        <StackPanel Orientation="Horizontal" MaxWidth="320">
            <TextBlock Text="⏰" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="WinLock" Foreground="#9AA5B1" FontSize="11" Margin="0,0,0,2" />
                <TextBlock x:Name="MessageText" Foreground="White" FontSize="15"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
