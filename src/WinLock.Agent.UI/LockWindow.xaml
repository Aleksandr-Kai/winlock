<Window x:Class="WinLock.Agent.UI.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinLock"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" Background="#0B0F14"
        WindowStartupLocation="Manual">
    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#151B23" CornerRadius="16" Padding="40" Width="440">
            <StackPanel>
                <TextBlock Text="Компьютер заблокирован" Foreground="White" FontSize="24"
                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock x:Name="ReasonText" Foreground="#9AA5B1" FontSize="14"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           TextAlignment="Center" Margin="0,0,0,24" />

                <Border Background="White" CornerRadius="8" Padding="12"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image x:Name="QrImage" Width="220" Height="220" />
                </Border>

                <TextBlock Text="Покажите этот QR-код родителю в приложении WinLock — оно назовёт код разблокировки."
                           Foreground="#9AA5B1" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Минут добавить" Foreground="#9AA5B1" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="MinutesBox" Text="30" Padding="8" FontSize="14" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Код от родителя" Foreground="#9AA5B1" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="CodeBox" Padding="8" FontSize="14" MaxLength="4" />
                    </StackPanel>
                </Grid>

                <Button x:Name="UnlockButton" Content="Разблокировать" Padding="0,10"
                        FontSize="15" Click="UnlockButton_Click" Margin="0,0,0,8" />
                <Button x:Name="RefreshButton" Content="Обновить QR-код" Padding="0,6"
                        FontSize="12" Background="Transparent" BorderThickness="0"
                        Foreground="#9AA5B1" Click="RefreshButton_Click" />

                <TextBlock x:Name="StatusText" Foreground="#E5484D" FontSize="13"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
